{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LensTemper Synthesis Output",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "pass_id",
    "target_path",
    "target_revision",
    "run_mode",
    "included_review_record_ids",
    "superseded_review_record_ids",
    "finding_decisions",
    "lens_lock_decisions",
    "claim_flags",
    "prior_material_findings_context",
    "final_assessment",
    "artifact_path",
    "markdown_artifact_path",
    "markdown_artifact_sha"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "record_id": { "type": "string" },
    "pass_id": { "type": "string" },
    "target_path": { "type": "string" },
    "target_revision": { "type": "string" },
    "review_input_revision": { "type": "string" },
    "run_mode": {
      "enum": ["full", "inline", "advisory"]
    },
    "included_review_record_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "superseded_review_record_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "finding_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "source_lens",
          "source_review_record_id",
          "decision",
          "reason"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "source_lens": { "type": "string" },
          "source_review_record_id": { "type": "string" },
          "decision": { "enum": ["accepted", "rejected", "downgraded", "deferred", "needs_author"] },
          "severity": { "enum": ["critical", "major", "minor"] },
          "affects_rerun_scope": {
            "description": "Legacy and optional. Reruns follow applied findings and affected_lenses, not this flag.",
            "type": "boolean"
          },
          "affected_lenses": {
            "description": "Other lenses whose settled review this finding's fix would invalidate. Applying the finding reopens its source lens and these lenses.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "reason": { "type": "string", "minLength": 1 },
          "change_type": { "enum": ["clarify", "add", "remove"] },
          "serves_goal": {
            "description": "Goal id from the intent card, or goal text when no card exists; null when the change serves no stated goal.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "rejection_reason": {
            "enum": [
              "conflicts_with_goal",
              "adds_unrequested_scope",
              "implementer_discretion",
              "unsupported",
              "duplicate",
              "out_of_domain",
              "contradicted"
            ]
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "required": ["decision", "change_type"],
              "properties": { "decision": { "const": "accepted" }, "change_type": { "const": "add" } }
            },
            "then": {
              "required": ["serves_goal"],
              "properties": { "serves_goal": { "type": "string" } }
            }
          },
          {
            "if": { "required": ["decision"], "properties": { "decision": { "const": "needs_author" } } },
            "then": { "not": { "required": ["change_type"] } }
          },
          {
            "if": { "required": ["rejection_reason"] },
            "then": { "properties": { "decision": { "const": "rejected" } } }
          }
        ]
      }
    },
    "lens_lock_decisions": {
      "type": "array",
      "description": "Per-lens state. Current records use lens_state; legacy records use lock_state with rerun_needed, mapped as passing_locked and converged_locked to settled, otherwise open when rerun_needed is true and settled when it is false.",
      "items": {
        "type": "object",
        "required": ["lens", "reason"],
        "anyOf": [
          { "required": ["lens_state"] },
          { "required": ["lock_state", "rerun_needed"] }
        ],
        "properties": {
          "lens": { "type": "string" },
          "lens_state": { "enum": ["open", "settled"] },
          "lock_state": {
            "enum": [
              "active",
              "failing",
              "passing_locked",
              "rerun_required",
              "converged_locked",
              "not_affected",
              "superseded",
              "error"
            ]
          },
          "rerun_needed": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "claim_flags": {
      "type": "object",
      "required": ["completion", "lock_state", "all_5_lockable", "review_complete"],
      "properties": {
        "completion": { "type": "boolean" },
        "lock_state": { "type": "boolean" },
        "all_5_lockable": { "type": "boolean" },
        "review_complete": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "prior_material_findings_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_record_id",
          "finding_id",
          "source_target_path",
          "source_target_revision",
          "decision",
          "severity"
        ],
        "properties": {
          "source_record_id": { "type": "string" },
          "finding_id": { "type": "string" },
          "source_target_path": { "type": "string" },
          "source_target_revision": { "type": "string" },
          "decision": { "enum": ["accepted", "rejected", "downgraded", "deferred", "needs_author"] },
          "severity": { "enum": ["critical", "major", "minor"] }
        },
        "additionalProperties": true
      }
    },
    "final_assessment": {
      "enum": [
        "Ready to implement",
        "Ready with minor clarifications",
        "Needs revision",
        "Not implementation-ready",
        "Goal drift"
      ]
    },
    "scope_delta": {
      "description": "Surface the accepted changes add and remove. A reductive goal whose net surface grows forces the Goal drift assessment.",
      "type": "object",
      "required": ["added", "removed", "net", "reductive_goal"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "net": { "enum": ["grows", "shrinks", "unchanged"] },
        "reductive_goal": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifact_path": { "type": "string" },
    "markdown_artifact_path": { "type": "string" },
    "markdown_artifact_sha": { "type": "string" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "run_mode": { "const": "full" } } },
      "then": {
        "required": ["review_input_revision"]
      }
    },
    {
      "if": {
        "required": ["scope_delta"],
        "properties": {
          "scope_delta": {
            "properties": { "net": { "const": "grows" }, "reductive_goal": { "const": true } }
          }
        }
      },
      "then": {
        "properties": { "final_assessment": { "const": "Goal drift" } }
      }
    }
  ]
}
