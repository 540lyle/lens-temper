{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LensTemper Review Input",
  "type": "object",
  "required": [
    "schema_version",
    "feature_request",
    "relevant_context",
    "constraints",
    "previous_adjudications"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "feature_request": { "type": "string", "minLength": 1 },
    "intent": {
      "description": "Optional intent card. When present it is the goal reference for reviewers and synthesis; when absent reviewers infer the goal.",
      "type": "object",
      "required": ["goals"],
      "properties": {
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "success_signal": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "non_goals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "must_not_grow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "decided_tradeoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["decision", "rejected_alternative", "why"],
            "properties": {
              "decision": { "type": "string", "minLength": 1 },
              "rejected_alternative": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "amended_by": {
          "description": "Set when the card differs from the parent pass's card. Only the plan's owner may amend it; a ledger whose card differs from its parent_intent_revision without this fails validation.",
          "enum": ["human"]
        }
      },
      "additionalProperties": false
    },
    "relevant_context": { "type": "string" },
    "constraints": { "type": "string" },
    "previous_adjudications": { "type": "string" }
  },
  "additionalProperties": false
}
